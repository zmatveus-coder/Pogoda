<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Погода — Telegram Mini App</title>
  <!-- Подключение Telegram Web Apps SDK -->
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    :root {
      --bg-color: var(--tg-theme-bg-color, #ffffff);
      --secondary-bg: var(--tg-theme-secondary-bg-color, #f4f4f5);
      --text-color: var(--tg-theme-text-color, #111111);
      --hint-color: var(--tg-theme-hint-color, #8e8e93);
      --btn-color: var(--tg-theme-button-color, #2481cc);
      --btn-text: var(--tg-theme-button-text-color, #ffffff);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-color);
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      min-height: 100vh;
    }

    .search-box {
      display: flex;
      gap: 8px;
    }

    input {
      flex: 1;
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid rgba(128, 128, 128, 0.2);
      background-color: var(--secondary-bg);
      color: var(--text-color);
      font-size: 16px;
      outline: none;
    }

    button {
      padding: 12px 18px;
      border-radius: 12px;
      border: none;
      background-color: var(--btn-color);
      color: var(--btn-text);
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    button:active {
      opacity: 0.8;
    }

    .card {
      background-color: var(--secondary-bg);
      border-radius: 20px;
      padding: 24px 20px;
      text-align: center;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    }

    .city-name {
      font-size: 22px;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .weather-desc {
      font-size: 15px;
      color: var(--hint-color);
      margin-bottom: 16px;
    }

    .temp-main {
      font-size: 56px;
      font-weight: 800;
      line-height: 1.1;
      margin: 8px 0 20px;
    }

    .details-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      border-top: 1px solid rgba(128, 128, 128, 0.15);
      padding-top: 16px;
    }

    .detail-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .detail-label {
      font-size: 12px;
      color: var(--hint-color);
    }

    .detail-val {
      font-size: 15px;
      font-weight: 600;
    }

    .status-msg {
      text-align: center;
      color: var(--hint-color);
      font-size: 14px;
      padding: 20px 0;
    }
  </style>
</head>
<body>

  <div class="search-box">
    <input type="text" id="cityInput" placeholder="Введите город..." value="Москва" />
    <button id="searchBtn">Найти</button>
  </div>

  <div id="weatherContainer" class="card">
    <div class="status-msg">Загрузка погоды...</div>
  </div>

  <script>
    // Инициализация Telegram Mini App
    const tg = window.Telegram.WebApp;
    tg.ready();
    tg.expand();

    const cityInput = document.getElementById('cityInput');
    const searchBtn = document.getElementById('searchBtn');
    const container = document.getElementById('weatherContainer');

    // Расшифровка кодов погоды WMO
    const weatherCodes = {
      0: { icon: '☀️', text: 'Ясно' },
      1: { icon: '🌤️', text: 'Преимущественно ясно' },
      2: { icon: '⛅', text: 'Переменная облачность' },
      3: { icon: '☁️', text: 'Пасмурно' },
      45: { icon: '🌫️', text: 'Туман' },
      48: { icon: '🌫️', text: 'Изморозь' },
      51: { icon: '🌦️', text: 'Легкая морось' },
      53: { icon: '🌦️', text: 'Морось' },
      55: { icon: '🌧️', text: 'Сильная морось' },
      61: { icon: '🌧️', text: 'Небольшой дождь' },
      63: { icon: '🌧️', text: 'Дождь' },
      65: { icon: '⛈️', text: 'Сильный дождь' },
      71: { icon: '🌨️', text: 'Небольшой снег' },
      73: { icon: '🌨️', text: 'Снег' },
      75: { icon: '❄️', text: 'Сильный снегопад' },
      80: { icon: '🌦️', text: 'Ливень' },
      95: { icon: '⛈️', text: 'Гроза' }
    };

    async function loadWeather(query) {
      if (!query.trim()) return;
      container.innerHTML = '<div class="status-msg">Обновление данных...</div>';

      try {
        // 1. Поиск координат города через геокодинг Open-Meteo
        const geoRes = await fetch(`https://open-meteo.com{encodeURIComponent(query)}&count=1&language=ru&format=json`);
        const geoData = await geoRes.json();

        if (!geoData.results || geoData.results.length === 0) {
          container.innerHTML = '<div class="status-msg">Город не найден 😕</div>';
          return;
        }

        const place = geoData.results[0];

        // 2. Получение текущей погоды по координатам
        const weatherUrl = `https://open-meteo.com{place.latitude}&longitude=${place.longitude}&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m&wind_speed_unit=ms`;
        const weatherRes = await fetch(weatherUrl);
        const weatherData = await weatherRes.json();
        const current = weatherData.current;

        const info = weatherCodes[current.weather_code] || { icon: '🌡️', text: 'Погода' };
        const temp = Math.round(current.temperature_2m);
        const feelsLike = Math.round(current.apparent_temperature);

        // Вибрация при успешном ответе (если открыто в Telegram)
        if (tg.HapticFeedback) {
          tg.HapticFeedback.impactOccurred('light');
        }

        container.innerHTML = `
          <div class="city-name">${place.name}${place.country ? ', ' + place.country : ''}</div>
          <div class="weather-desc">${info.icon} ${info.text}</div>
          <div class="temp-main">${temp > 0 ? '+' + temp : temp}°C</div>
          <div class="details-grid">
            <div class="detail-item">
              <span class="detail-label">Ощущается</span>
              <span class="detail-val">${feelsLike > 0 ? '+' + feelsLike : feelsLike}°C</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Ветер</span>
              <span class="detail-val">${current.wind_speed_10m} м/с</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Влажность</span>
              <span class="detail-val">${current.relative_humidity_2m}%</span>
            </div>
          </div>
        `;
      } catch (err) {
        container.innerHTML = '<div class="status-msg">Ошибка соединения с сервером ⚠️</div>';
      }
    }

    searchBtn.addEventListener('click', () => loadWeather(cityInput.value));
    cityInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') loadWeather(cityInput.value);
    });

    // Первый запуск по умолчанию
    loadWeather(cityInput.value);
  </script>
</body>
</html>
